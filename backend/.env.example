# Backend configuration for running outside Docker (pnpm dev creates
# backend/.env from the dev deployment on first run). Every variable is
# validated at start-up; see src/config/env.ts for defaults and the rest
# (DB_POOL_MAX and DB_STATEMENT_TIMEOUT_MS are read by db/src/index.ts).

# Real Stellar testnet config — no mocked endpoints.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ESCROW_GATE_CONTRACT_ID=
ZK_VERIFIER_REGISTRY_CONTRACT_ID=
BOND_ASSET_CONTRACT_ID=
DEPLOYMENT_NAME=testnet

DATABASE_URL=postgres://verity:verity@localhost:5433/verity
# Maximum number of concurrent connections in the Postgres pool (default: 10).
# DB_POOL_MAX=10
# Milliseconds before a query times out; 0 disables the timeout (default: 30000).
# DB_STATEMENT_TIMEOUT_MS=30000

# Verity's own signing key for keeper-driven calls (finalize, resolve,
# release locks). Never a user's key — users sign their own transactions.
KEEPER_SECRET_KEY=
# Signs verdict attestations. Optional (falls back to the keeper key); give it its
# own key so rotating the keeper does not change every future attestation's signer.
# ATTESTATION_SIGNING_SECRET=
# Signs SEP-10 sign-in challenges. Optional locally (falls back to the keeper
# key); set it on any deployment other people use.
# SEP10_SIGNING_SECRET=

# At least 32 characters: openssl rand -hex 32
JWT_SECRET=
WEB_AUTH_DOMAIN=localhost:3001
HOME_DOMAIN=localhost:3001
PUBLIC_SCHEME=http
PORT=3001

ARTIFACT_STORAGE_DIR=./.artifacts

# Exactly one backend process may run the indexer and keeper.
RUN_WORKERS=true
# true only behind a reverse proxy you control.
TRUST_PROXY=false

# --- Tuning (optional; defaults shown) ---
# Worker polling recency in seconds required to count a re-executor as online.
# REEXECUTOR_LIVENESS_S=60
# Extra replay assignees beyond quorum; 0 disables spare assignments.
# REPLAY_OVERASSIGN=1
# Seconds before an unanswered assignment stops counting and another is asked.
# REPLAY_REASSIGN_AFTER_S=120
# Delete off-chain drafts after this many seconds since their last update.
# DRAFT_TTL_S=3600
# Maximum decoded artifact bytes; also bounded by the fixed 1 MiB JSON body limit.
# ARTIFACT_MAX_BYTES=262144
# ARTIFACT_MAX_TOTAL_BYTES=10737418240
# ARTIFACT_UPLOADS_PER_MINUTE=30
# Requests per minute per client address, and again per authenticated account.
# RATE_LIMIT_PER_MINUTE=300
# Requests per minute per client address for GET/POST /auth (identity minting).
# AUTH_REQUESTS_PER_MINUTE=20
