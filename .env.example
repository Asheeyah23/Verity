# Configuration for docker-compose.yml. Copy to .env and fill it in.
# Never commit .env. Full walkthrough: docs/DEPLOY.md.

# --- Which contracts this stack serves -------------------------------------
# From deployments/<name>.json, written by scripts/deploy_testnet.sh.
ESCROW_GATE_CONTRACT_ID=
# Required by backend startup validation; the empty Phase 2 registry from the
# same deployment file (not called in Phase 1).
ZK_VERIFIER_REGISTRY_CONTRACT_ID=
# The token EscrowGate takes bonds and stakes in: bond_asset_sac_address from
# the deployment file (native_xlm_sac_address in a record written before that
# field existed). The backend reads the gate's own asset when it starts and
# refuses to start if this is a different one.
BOND_ASSET_CONTRACT_ID=
# Shown by GET /health so tooling can tell deployments apart.
DEPLOYMENT_NAME=public

# --- Network (defaults are Stellar testnet) --------------------------------
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Also baked into the dashboard client bundle at image build time
# (NEXT_PUBLIC_NETWORK_PASSPHRASE), so changing it requires
# `docker compose up -d --build`, not just a restart.
# NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Public address --------------------------------------------------------
# Host (and port, if any) the backend API is reached on, without a scheme.
# Wallets show this when users sign in.
WEB_AUTH_DOMAIN=
HOME_DOMAIN=
# Scheme advertised in /.well-known/stellar.toml (WEB_AUTH_ENDPOINT); use https
# behind any real reverse proxy. The sign-in cookie's Secure flag is separate:
# it depends on the dashboard running in production (docs/DEPLOY.md, section 4).
PUBLIC_SCHEME=https
# Interfaces the containers publish on. Keep 127.0.0.1 and put a reverse
# proxy in front; 0.0.0.0 exposes them directly.
# API_BIND=127.0.0.1
# WEB_BIND=127.0.0.1

# --- Secrets ---------------------------------------------------------------
# Database password, any long random string: openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs session tokens, at least 32 characters: openssl rand -hex 32
JWT_SECRET=
# Pays for keeper transactions (finalize, resolve, release). Needs testnet XLM.
#   stellar keys secret verity-<deployment>-keeper
KEEPER_SECRET_KEY=
# Signs sign-in challenges. Any funded-or-not Stellar secret key, distinct
# from the keeper's:  stellar keys generate verity-<deployment>-sep10 && stellar keys secret verity-<deployment>-sep10
SEP10_SIGNING_SECRET=

# --- Optional backend tuning -----------------------------------------------
# Signs verdict attestations. Optional (defaults to KEEPER_SECRET_KEY); give it
# its own key so rotating the keeper does not change every future attestation's signer.
# ATTESTATION_SIGNING_SECRET=
# The indexer and keeper share one cursor and sequence; only one process may run them.
# RUN_WORKERS=true
# RATE_LIMIT_PER_MINUTE=300
# REEXECUTOR_LIVENESS_S=60
# REPLAY_OVERASSIGN=1
# REPLAY_REASSIGN_AFTER_S=120
# Minimum 390 (a built transaction's 330 s validity plus 60 s for the relay);
# the backend refuses to start with a lower value.
# DRAFT_TTL_S=3600
# ARTIFACT_MAX_BYTES=262144
# ARTIFACT_MAX_TOTAL_BYTES=10737418240
# ARTIFACT_UPLOADS_PER_MINUTE=30
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000

# --- Re-executor fleet (docker compose --profile fleet) --------------------
# Staked, approved accounts created by scripts/bootstrap_reexecutors.sh:
#   stellar keys secret verity-<deployment>-rex1   (and rex2..rex5)
REX1_SECRET_KEY=
REX2_SECRET_KEY=
REX3_SECRET_KEY=
REX4_SECRET_KEY=
REX5_SECRET_KEY=
# Milliseconds between polls of the backend for assignments (default: 3000).
# POLL_INTERVAL_MS=3000
# HEARTBEAT_INTERVAL_MS=15000
# RETRIEVAL_RETRY_BUDGET_S=120
# CONNECTIVITY_CHECK_URL=https://soroban-testnet.stellar.org
