BACKEND_URL=http://localhost:3001
REEXECUTOR_SECRET_KEY=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Must match what the backend reports at GET /v1/config; the worker refuses to start on a mismatch.
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ESCROW_GATE_CONTRACT_ID=
POLL_INTERVAL_MS=3000

# How often the worker tells the backend it is alive, independently of the work
# loop, so a long replay does not make it look offline. Keep it well under the
# backend's REEXECUTOR_LIVENESS_S (60 s).
HEARTBEAT_INTERVAL_MS=15000

# How long a retrieval target may stay unreachable before this worker votes
# mismatch on it (capped at half the submission's challenge window).
RETRIEVAL_RETRY_BUDGET_S=120
# An endpoint this worker must be able to reach anyway. If it cannot, an
# unreachable retrieval target is blamed on this host's network and no vote
# is cast. Defaults to SOROBAN_RPC_URL. May be a local or private address.
# CONNECTIVITY_CHECK_URL=

# When CONNECTIVITY_CHECK_URL resolves to a private or loopback address, this
# public endpoint is probed to verify public internet access before voting
# mismatch on an unreachable retrieval target. Defaults to Horizon for the
# active network (https://horizon-testnet.stellar.org on testnet,
# https://horizon.stellar.org on mainnet).
# INTERNET_CHECK_URL=

# SEP-10: the worker only signs a login challenge the Verity server itself
# signed, for the expected home and web-auth domains. All three are
# discovered from the backend's /.well-known/stellar.toml at startup, so
# pnpm dev and the compose fleet need no extra configuration. Set them to
# pin the server instead of trusting the toml — e.g. when the backend is
# reached through a proxy whose toml is not the deployment's.
# SEP10_SERVER_KEY=
# SEP10_HOME_DOMAIN=
# SEP10_WEB_AUTH_DOMAIN=
